[Desktop Entry]
Type=Application
Version=1.0
Name=ESP32 Visual Serial Terminal
GenericName=Serial Terminal
Comment=Render HTML pushed by a device over a serial link
Exec=@BIN@
Icon=esp32-visual-serial-terminal
Categories=Development;Electronics;Utility;
Keywords=serial;uart;esp32;terminal;embedded;
# The application uses the terminal as its control surface: connect, request a
# page, view the log. Without one it still runs and still shows the page, but
# those controls are unreachable.
Terminal=true
StartupNotify=false
