<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Esp32VisualSerialTerminal</RootNamespace>
    <AssemblyName>esp32-visual-serial-terminal-gtk</AssemblyName>
    <MyType>Empty</MyType>
    <StartupObject>Esp32VisualSerialTerminal.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <Product>ESP32 Visual Serial Terminal</Product>
    <AssemblyTitle>ESP32 Visual Serial Terminal</AssemblyTitle>
    <Description>Native GTK4 application that renders HTML pushed by a device over serial, at the exact pixel dimensions of a target display.</Description>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The protocol, the serial link, the viewer server and the shell page are
       shared with the Windows host by reference, not by copy. -->
  <ItemGroup>
    <Compile Include="..\Esp32VisualSerialTerminal\Protocol\*.vb">
      <Link>Shared\Protocol\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\Esp32VisualSerialTerminal\Transport\*.vb">
      <Link>Shared\Transport\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\Esp32VisualSerialTerminal\Server\*.vb">
      <Link>Shared\Server\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\Esp32VisualSerialTerminal\Session\*.vb">
      <Link>Shared\Session\%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Reuse LinuxSerialPorts from the console Linux project -->
    <Compile Include="..\Esp32VisualSerialTerminal.Linux\LinuxSerialPorts.vb">
      <Link>Shared\LinuxSerialPorts.vb</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Esp32VisualSerialTerminal\Shell\shell.html">
      <Link>Shared\Shell\shell.html</Link>
      <LogicalName>Esp32VisualSerialTerminal.Shell.shell.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.7.0" />
    <PackageReference Include="GirCore.WebKit-6.0" Version="0.7.0" />
    <PackageReference Include="GirCore.Adw-1" Version="0.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Linq" />
  </ItemGroup>

</Project>
