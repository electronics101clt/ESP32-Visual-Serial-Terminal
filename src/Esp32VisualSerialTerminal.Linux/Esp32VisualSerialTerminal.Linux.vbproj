<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- No -windows suffix: nothing here touches Windows Forms or WebView2. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Esp32VisualSerialTerminal</RootNamespace>
    <AssemblyName>esp32-visual-serial-terminal</AssemblyName>
    <!-- Empty, not Console: the Console variant pulls in
         Microsoft.VisualBasic.ApplicationServices, which is not part of the
         cross-platform targeting pack. Nothing here needs the My namespace. -->
    <MyType>Empty</MyType>
    <StartupObject>Esp32VisualSerialTerminal.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
    <InvariantGlobalization>true</InvariantGlobalization>
    <inRuntimeIdentifiers>linux-x64;linux-arm64</inRuntimeIdentifiers>
    <Product>ESP32 Visual Serial Terminal</Product>
    <AssemblyTitle>ESP32 Visual Serial Terminal</AssemblyTitle>
    <Description>Renders HTML pushed by a device over serial, at the exact pixel dimensions of a target display.</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- The protocol, the serial link, the viewer server and the shell page are
       shared with the Windows host by reference, not by copy. A reference
       implementation containing two divergent implementations of its own
       specification would leave the specification answering to neither. -->
  <ItemGroup>
    <Compile Include="..\Esp32VisualSerialTerminal\Protocol\*.vb">
      <Link>Shared\Protocol\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\Esp32VisualSerialTerminal\Transport\*.vb">
      <Link>Shared\Transport\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\Esp32VisualSerialTerminal\Server\*.vb">
      <Link>Shared\Server\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\Esp32VisualSerialTerminal\Session\*.vb">
      <Link>Shared\Session\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- LogicalName is set explicitly: the server locates this resource by name,
         and a linked file would otherwise be named from its path on disk. -->
    <EmbeddedResource Include="..\Esp32VisualSerialTerminal\Shell\shell.html">
      <Link>Shared\Shell\shell.html</Link>
      <LogicalName>Esp32VisualSerialTerminal.Shell.shell.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Linq" />
  </ItemGroup>

</Project>
